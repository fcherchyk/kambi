# Copy to `.env` (git-ignored) and replace every placeholder.

# PostgreSQL password for the `db` service. DATABASE_URL below must use the same one.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kambi:change-me@db:5432/kambi

# Google OAuth client (see README, "Google OAuth setup").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:5174/api/auth/callback

# Signs the short-lived login cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Development login without Google, for the offline sandbox (`run-sandbox.sh` turns it on).
# Never enable it outside your own machine.
DEV_LOGIN=false
